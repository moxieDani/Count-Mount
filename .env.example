# SvelteKit environment variables must be prefixed with VITE_ to be exposed to the client
# See: https://kit.svelte.dev/docs/modules#$env-static-public

# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google API Key (for client-side API calls)
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Auth.js Secret (generate random string) - Used for server-side auth, which is now disabled
AUTH_SECRET=your_auth_secret_here

# Trusted Host (for production) - Used for server-side auth, which is now disabled
AUTH_TRUST_HOST=true

# 로그인을 허용할 Google 계정 이메일 (쉼표로 구분). 비어 있으면 아무도 로그인할 수 없음
ALLOWED_EMAILS=you@gmail.com,spouse@gmail.com

# 카드 실적 탭이 읽을 카드사용내역 문서 이름. {year} 는 올해로 바뀜. 비우면 "{year} 카드사용내역"
# CARD_USAGE_DOC_NAME="{year} 테스트 카드사용내역"

# 정산 금액 배지를 폰에서 두 번 탭했을 때 토스로 보낼 받는 계좌 ("은행이름 계좌번호", 은행 이름은 토스 앱에 보이는 대로)
# 저장소가 공개이므로 실제 계좌번호는 여기 말고 Vercel 환경 변수에만 넣는다
# SETTLEMENT_ACCOUNT_SEOEUN="은행이름 000-0000-0000-00"
# SETTLEMENT_ACCOUNT_KISOON="은행이름 000-0000-0000-00"
